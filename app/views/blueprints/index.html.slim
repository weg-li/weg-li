- set_title t('navigation.blueprints')

.panel.panel-default
  .panel-heading
    .row
      .col-xs-8
        = link_to new_blueprint_path, class: 'btn btn-sm btn-success', title: 'Vorlage anlegen'
          span.glyphicon.glyphicon-plus>
          | Vorlage anlegen
      .col-xs-4.text-right
        button.btn.btn-default.btn-sm.dropdown-toggle type="button" data-toggle="dropdown"
          | <span class="glyphicon glyphicon-search"></span> Suche <span class="caret"></span>
        ul.dropdown-menu.dropdown-menu-right
          li
            = form_tag(url_for, method: :get, class: 'form-dropdown', autocomplete: :off)
              .input-group.input-group-sm
                = hidden_field_tag('order[column]', @table_params[:order][:column])
                = hidden_field_tag('order[value]', @table_params[:order][:value])
                = text_field_tag('search[term]', @table_params[:search][:term], placeholder: 'z.B. Blechdose', class: 'form-control', aria: { label: 'Suche' })
                span.input-group-btn
                  = button_tag(class: "btn btn-default btn-sm", aria: { label: 'Suchen' })
                    span.glyphicon.glyphicon-search
          - if @table_params[:search][:term].present?
            li.divider
            li
              = link_to url_for(@table_params.merge(search: nil))
                span.glyphicon.glyphicon-remove>
                | ohne Suche

  .table-responsive.table-padding
    table.table.table-striped.table-hover
      thead
        tr
          th
          th
            => Blueprint.human_attribute_name(:created_at)
            - if params.dig(:order, :column) == 'created_at'
              - if params.dig(:order, :value) == 'ASC'
                = link_to url_for(@table_params.deep_merge(order: {column: :created_at, value: 'DESC'})), aria: { label: "Nach #{Blueprint.human_attribute_name(:created_at)} absteigend sortieren" }
                  span.glyphicon.glyphicon-arrow-up.smaller
              - else
                = link_to url_for(@table_params.deep_merge(order: {column: :created_at, value: 'ASC'})), aria: { label: "Nach #{Blueprint.human_attribute_name(:created_at)} aufsteigend sortieren" }
                  span.glyphicon.glyphicon-arrow-down.smaller
              = link_to url_for(@table_params.merge(order: {})), aria: { label: 'Sortierung entfernen' }
                span.text-muted.glyphicon.glyphicon-remove.smaller
            - else
              = link_to url_for(@table_params.deep_merge(order: {column: :created_at, value: 'ASC'})), aria: { label: "Nach #{Blueprint.human_attribute_name(:created_at)} aufsteigend sortieren" }
                span.glyphicon.glyphicon-arrow-up.smaller.text-muted
          th
            => Blueprint.human_attribute_name(:name)
            - if params.dig(:order, :column) == 'name'
              - if params.dig(:order, :value) == 'ASC'
                = link_to url_for(@table_params.deep_merge(order: {column: :name, value: 'DESC'})), aria: { label: "Nach #{Blueprint.human_attribute_name(:name)} absteigend sortieren" }
                  span.glyphicon.glyphicon-arrow-up.smaller
              - else
                = link_to url_for(@table_params.deep_merge(order: {column: :name, value: 'ASC'})), aria: { label: "Nach #{Blueprint.human_attribute_name(:name)} aufsteigend sortieren" }
                  span.glyphicon.glyphicon-arrow-down.smaller
              = link_to url_for(@table_params.merge(order: {})), aria: { label: 'Sortierung entfernen' }
                span.text-muted.glyphicon.glyphicon-remove.smaller
            - else
              = link_to url_for(@table_params.deep_merge(order: {column: :name, value: 'ASC'})), aria: { label: "Nach #{Blueprint.human_attribute_name(:name)} aufsteigend sortieren" }
                span.glyphicon.glyphicon-arrow-up.smaller.text-muted
      tbody
        - if @blueprints.present?
          - @blueprints.each do |blueprint|
            tr
              td
                label.btn-sm
                  = check_box_tag "selected[]", blueprint.id, false, class: 'select-all checkbox-addon', aria: { label: 'Vorlage auswählen' }
                .btn-group.dropdown
                  = render('blueprint_actions', blueprint: blueprint)
              td(nowrap)= link_to l(blueprint.created_at, format: :short, default: '-'), blueprint_path(blueprint)
              td= link_to blueprint.name, blueprint_path(blueprint)

        - else
          tr
            td(colspan=7)= t('blueprints.nothing_found')

.text-center
  = paginate @blueprints
